[global]
AuthservID      = mail.example.com
WorkerThreads   = 0
Syslog          = yes
SyslogFacility  = mail
PidFile         = /var/run/securearc/securearc.pid
User            = _arc
Foreground      = no
DnsNameserver   = 127.0.0.1
DnsTimeout      = 5
DnsRetries      = 2
ZmqEndpoint     = tcp://events.internal:5555
ZmqTopic        = arc

# Signing key for ARC sealing (same format as DKIM)
SealDomain      = example.com
SealSelector    = arc2026
SealKeyFile     = /usr/local/etc/securearc/keys/arc.key
SignedHeaders    = from:to:subject:date:message-id

# Authentication methods this ADMD evaluates locally, i.e. the results the
# other SecureMilter daemons on this host add to the message.
# Only these may be copied into an ARC-Authentication-Results header and
# sealed with our key. Empty (the default) means this host authenticates
# nothing itself, so its AAR honestly reports "none" instead of repeating
# whatever the sender wrote (RFC 8617 section 5.1.1).
# Set it only for the methods that really run here:
LocalAuthMethods = spf, dkim, dmarc

# Trust boundary (RFC 8601 section 5).
# SecureARC always removes pre-existing Authentication-Results headers that
# claim our AuthservID and assert an arc= result. Set this to yes when
# SecureARC is the first (or only) milter in the chain, to remove every
# Authentication-Results header claiming our AuthservID regardless of method.
# StripAuthResults = no

# --- Resource limits on attacker-controlled message content ---
#
# All take effect at startup, not on SIGHUP. 0 disables the limit.

# Largest message body this daemon will buffer in order to hash it.
# Accepts a K/M/G suffix. Default 10M.
#
# Set this at or above Postfix's message_size_limit. A body over the limit is
# not hashed and not truncated: chain validation reports arc=temperror and
# sealing is skipped, since an ARC-Message-Signature over a partial copy would
# name this ADMD as the hop that broke the chain.
# MaxBodyBytes  = 10M

# Largest number of headers, and largest total header size, this daemon will
# accumulate. Defaults 500 and 1M.
#
# A message whose header block exceeds either is tempfailed rather than
# delivered: headers past the limit are never seen, so a forged
# Authentication-Results hidden beyond it could not be stripped.
#
# MaxHeaders is what bounds ARC verification cost. Note that one ARC set is three
# headers and RFC 8617 permits 50 sets, so a full-length chain is 150 headers on
# its own; do not tune this below roughly 300 if deep chains are expected.
# MaxHeaders     = 500
# MaxHeaderBytes = 1M

# MaxSignatures is not used by SecureARC. RFC 8617 section 5.1.1 caps a chain at
# 50 sets and SecureARC already fails any chain longer than that, so refusing a
# shorter, RFC-legal chain to save work would be a conformance bug.

# --- Minimum key size for sealed hops ---

# Smallest RSA key, in bits, accepted on an ARC-Message-Signature or ARC-Seal.
# Default 1024.
#
# ARC inherits DKIM's cryptography, so RFC 8301 section 3.2 applies here too:
# verifiers "MUST NOT consider signatures using RSA keys of less than 1024 bits
# as valid signatures". Unlike the MaxNNN limits above, 0 does NOT disable this;
# anything below 1024 is raised to 1024 and a warning is logged.
#
# A set signed with an undersized key fails the chain (arc=fail), because a hop
# whose signature proves nothing cannot be a link in a chain of custody. The
# reported reason names the key rather than the signature, so the failure can be
# taken up with the forwarder that produced it.
#
# This applies only to keys other ADMDs publish. This daemon's own seal key is
# always held to the 1024-bit floor regardless of what is set here.
# MinimumKeyBits = 1024

# What a sealing listener does when a previous hop's key cannot be fetched
# because DNS failed transiently — SERVFAIL, a timeout, an unreachable resolver.
#
# RFC 8617 5.1.2 makes cv=fail permanent for the life of the message: no later
# hop may revise it. So this is the one condition where the cheapest response
# for this host is the most destructive one overall, because the cost lands on
# the sender and every downstream receiver instead of here.
#
#   tempfail   (default) Defer with a 4xx; the sender retries. The only
#              non-destructive answer for a hop that modifies messages, which
#              is what sealing is for. Risk: a lame delegation that keeps
#              returning a transient-looking error burns maximal_queue_lifetime
#              and then bounces.
#   skip-seal  Add no ARC set, report arc=temperror, pass through unchanged.
#              No delay, and right for a relay that does not alter messages.
#              It does NOT rescue the chain if this hop does alter them: the
#              previous hop's AMS then covers changed content and the next hop
#              computes cv=fail anyway. It only moves who breaks the chain.
#   seal-fail  Seal cv=fail. What releases before this option did. NOT
#              RECOMMENDED — the only setting that permanently destroys a chain
#              that may be perfectly valid.
#
# Verify listeners are not configurable: they report arc=temperror and deliver,
# because a verifier writes no permanent verdict into the message. An internal
# fault here (an allocation failure, say) always defers, in either role, and is
# never charged to the sender's chain.
# On-DNSError = tempfail

# Each listener has its own Mode: verify, seal, or both. A listener that omits
# Mode inherits a [global] Mode if one is set, otherwise verify. An unrecognised
# value is refused at startup rather than silently falling back.
#
# Releases before this one kept a single daemon-wide mode that each listener
# section overwrote in turn, so the last section won for every socket — this
# exact two-listener layout ran BOTH sockets in seal mode. Confirm the
# "listener[N] mode=..." lines logged at startup after upgrading.
#
# SealDomain, SealSelector and SealKeyFile are read from a listener section but
# apply daemon-wide: there is one seal key, so per-listener sealing identities
# are not supported.

[listener:verify-inbound]
Socket          = inet:8895@0.0.0.0
Mode            = verify

[listener:seal-relay]
Socket          = inet:8896@0.0.0.0
Mode            = seal
